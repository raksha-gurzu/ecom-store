# ─────────────────────────────────────────────────────────────────────────────
# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env     and fill in every value marked CHANGE ME.
#
# The compose file refuses to start if any required value is missing, so a
# half-filled file fails immediately and loudly rather than booting insecurely.
# Do NOT commit the filled-in .env — it is gitignored for that reason.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public identity ──────────────────────────────────────────────────────────
# The exact public origin this site is served on, no trailing slash.
# Product image URLs in the API response are built from this string, so if it is
# wrong every image 404s for the consumer even though the catalog looks fine.
# Must be the https:// address once TLS is in front of it.
PUBLIC_BASE_URL=https://CHANGE-ME.example.com

# ── API credentials ──────────────────────────────────────────────────────────
# READ_TOKEN  — handed to the catalog consumer; grants read access to /api/catalog
# ADMIN_TOKEN — full write access to /manage/*; internal only, never share
# Generate each one with:  openssl rand -hex 32
READ_TOKEN=CHANGE-ME-read-token
ADMIN_TOKEN=CHANGE-ME-admin-token

# ── Database credentials ─────────────────────────────────────────────────────
# POSTGRES_USER is the owner role (writes). READONLY_DB_PASSWORD sets the
# password for `gurzu_readonly`, the SELECT-only role the catalog reads through.
# The database NAME is fixed to merchant_catalog and is not configurable here —
# db/schema.sql grants privileges to that database by name.
POSTGRES_USER=merchant
POSTGRES_PASSWORD=CHANGE-ME-db-password
READONLY_DB_PASSWORD=CHANGE-ME-readonly-password

# ── Networking ───────────────────────────────────────────────────────────────
# Which host address the app binds to. The default 127.0.0.1 means "reachable
# only from the server itself" — correct when a reverse proxy terminates TLS in
# front of it. Set to 0.0.0.0 only if the container is exposed directly.
APP_BIND=127.0.0.1
APP_PORT=4000

# Deploy a prebuilt image from a registry instead of building from source.
# Leave unset to build the Dockerfile in this repo.
#APP_IMAGE=ghcr.io/OWNER/ecom-store:latest

# ── Optional ─────────────────────────────────────────────────────────────────
# Shown on the /api-info page as the external read-only DB connection string.
# Leave BLANK unless Postgres is deliberately published to outside consumers.
PUBLIC_DB_URL=

# Change notifications: the site POSTs an HMAC-signed payload here whenever a
# product changes through /manage/*. Leave both blank to disable.
GURZU_NOTIFY_URL=
HMAC_SECRET=
