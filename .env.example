# ─────────────────────────────────────────────────────────────────────────────
# Test merchant site — environment. Copy to `.env`. Use THROWAWAY secrets in dev.
# ─────────────────────────────────────────────────────────────────────────────

# Port the Express site listens on (spec uses 4000).
PORT=4000

# Public base URL used to build absolute image URLs in the catalog JSON.
# The connector downloads images from these URLs WITHOUT auth, so they must be
# reachable. For local dev this is the host the site is served on.
PUBLIC_BASE_URL=http://localhost:4000

# ── Phase 1: the read token shared with Gurzu at connect time ────────────────
# The catalog endpoint rejects anything without `Authorization: Bearer <token>`.
READ_TOKEN=merchant_demo_readonly_token_abc123

# ── Admin/manage endpoints token (this project's addition; NOT in Gurzu's contract)
# Protects the management CRUD endpoints that mutate the catalog.
ADMIN_TOKEN=merchant_demo_admin_token_def456

# ── Phase 2 (later): HMAC-signed change notifications ────────────────────────
HMAC_SECRET=demo_shared_hmac_secret_xyz789
GURZU_NOTIFY_URL=http://localhost:8000/v1/integrations/custom-pull/notify

# ── Database ─────────────────────────────────────────────────────────────────
# The APP (writes via manage endpoints + scraper) connects as the owner role.
DATABASE_URL=postgres://merchant:merchant_pw@localhost:5433/merchant_catalog

# The CATALOG read endpoint connects through a SELECT-only role, mirroring a
# real merchant exposing reads through a restricted DB role (spec §4.1).
READONLY_DATABASE_URL=postgres://gurzu_readonly:readonly_pw@localhost:5433/merchant_catalog
